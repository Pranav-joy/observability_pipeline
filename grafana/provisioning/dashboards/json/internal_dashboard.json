{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "internal-dashboard"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "Dashboard where log view is in singular line",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "P8E80F9AEF21F6940"
                      },
                      "group": "loki",
                      "kind": "DataQuery",
                      "spec": {
                        "direction": "backward",
                        "editorMode": "builder",
                        "expr": "{service_name=\"observability-api-1\"} | json",
                        "queryType": "range"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 1,
          "links": [
            {
              "targetBlank": true,
              "title": "Dashboard (wrapped)",
              "url": "/d/internal-dashboard-wrapped/internal-dashbard-wrapped?${__all_variables}"
            }
          ],
          "title": "New panel",
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "dedupStrategy": "none",
                "enableInfiniteScrolling": false,
                "enableLogDetails": true,
                "fontSize": "default",
                "prettifyLogMessage": true,
                "showControls": false,
                "showFieldSelector": false,
                "showLevel": true,
                "showTime": false,
                "sortOrder": "Descending",
                "timestampResolution": "ms",
                "unwrappedColumns": false,
                "wrapLogMessage": false
              }
            },
            "version": "13.1.1"
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              },
              "height": 22,
              "width": 24,
              "x": 0,
              "y": 0
            }
          }
        ]
      }
    },
    "links": [
      {
        "asDropdown": false,
        "icon": "external link",
        "includeVars": true,
        "keepTime": true,
        "tags": [],
        "targetBlank": true,
        "title": "Wrapped Dashboard",
        "tooltip": "",
        "type": "dashboards",
        "url": ""
      }
    ],
    "liveNow": false,
    "preferences": {
      "layout": {
        "kind": "GridLayout",
        "spec": {
          "items": []
        }
      }
    },
    "preload": false,
    "tags": [],
    "timeSettings": {
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-6h",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "Internal Dashbard",
    "variables": [
      {
        "datasource": {
          "name": "P8E80F9AEF21F6940"
        },
        "group": "loki",
        "kind": "AdhocVariable",
        "spec": {
          "allowCustomValue": true,
          "baseFilters": [],
          "defaultKeys": [
            {
              "text": "trace_id",
              "value": "trace_id"
            },
            {
              "text": "user_id",
              "value": "user_id"
            },
            {
              "text": "span_id",
              "value": "span_id"
            },
            {
              "text": "level",
              "value": "level"
            },
            {
              "text": "name",
              "value": "name"
            },
            {
              "text": "service_name",
              "value": "service_name"
            },
            {
              "text": "org_id",
              "value": "org_id"
            }
          ],
          "description": "Query the Logs on attributes\n",
          "enableGroupBy": false,
          "filters": [],
          "hide": "dontHide",
          "label": "Filters",
          "name": "Query_On_Attributes",
          "skipUrlSync": false
        }
      }
    ]
  }
}
